+      u32 parent=j%32,bit=u32(1)<<snew;
+      o.post.x[snew]=o.g[j];
+      if(((s.policy>>parent)^(d.flip>>snew))&1){
+        o.post.policy|=bit;
+        o.post.valid|=bit;
+        o.post.c[snew]=s.x[parent];
+      }
+    }
+    return o;
+  }
+  inline void rehash(Bytes&r){
+    need(r.size()==RECORD_BYTES);
