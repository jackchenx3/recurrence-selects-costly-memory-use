+    encode(r.data()+STATE_BASE,s);
+    for(u32 u=1;u<=256;++u){
+      auto o=turnover(s,targets[u-1],0,rng.tape(u));
+      s=o.post;
+      encode(r.data()+STATE_BASE+264*u,s);
+      put(r.data()+RETRY_BASE+4*(u-1),o.rejections,4);
+    }
+    followup(r,rng,s,reverse);
+    rehash(r);
+    return r;
+  }
